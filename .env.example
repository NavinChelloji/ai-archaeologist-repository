# Subset of the root .env.example this deployable actually reads.
# See WORKSPACE_AND_PACKAGE_STRATEGY.md "Independent Deployment Rule".
NODE_ENV=development
PORT=3100
INDEXER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aca_indexer
QUEUE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aca_queue
REDIS_URL=redis://localhost:6379
INTERNAL_JWT_SECRET=

# Repositories and Snapshots module (GITHUB_CONNECTOR_SERVICE_PLAN.md)
API_SERVICE_URL=http://localhost:3000
GITHUB_API_BASE_URL=https://api.github.com
MAX_REPOSITORY_ARCHIVE_MB=500
MAX_REPOSITORIES_PER_USER=10
SNAPSHOT_RETENTION_COUNT=2
TEMP_WORK_DIR=/tmp/aca
DOWNLOAD_TIMEOUT_SECONDS=600

# Object storage — doc calls this S3_BUCKET_SNAPSHOTS; kept as S3_BUCKET to
# match the checked-in root .env.example / docker-compose from Stage 1.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aca-snapshots
S3_ACCESS_KEY_ID=aca_minio_admin
S3_SECRET_ACCESS_KEY=aca_minio_admin_secret
S3_FORCE_PATH_STYLE=true

# Parser module — file inventory (REPOSITORY_PROCESSOR_SERVICE_PLAN.md)
MAX_EXTRACTED_SIZE_MB=2048
MAX_FILES_PER_REPO=20000
MAX_FILE_SIZE_KB=512
MAX_DIRECTORY_DEPTH=32

# Parser module — symbols and import resolution (REPOSITORY_PROCESSOR_SERVICE_PLAN.md)
PARSER_CONCURRENCY=4
PARSER_FILE_TIMEOUT_MS=10000
PARSER_BATCH_SIZE=500

# Graph module (GRAPH_SERVICE_PLAN.md)
GRAPH_QUERY_MAX_NODES=1500
GRAPH_NEIGHBOR_MAX_DEPTH=3
GRAPH_CACHE_TTL_SECONDS=300
GRAPH_BUILD_BATCH_SIZE=2000
